        {
          "description": "Your explorable 2D/2.5D illustrated city needs an original map layout that clearly connects neighborhoods, transit, workplaces, cultural venues, and social spaces while remaining readable during pan and zoom.",
          "id": "connected_city_map",
          "label": "Original connected city map"
        },
        {
          "description": "Your player needs a clear, original illustrated avatar that remains recognizable at map scale and supports basic movement and position feedback.",
          "id": "player_avatar",
          "label": "Player avatar"
        },
        {
          "description": "Your jobs, transit stops, workplaces, cultural venues, and social spaces need distinct original location visuals and clearly readable clickable zones without reproducing LagosLife landmarks or layouts.",
          "id": "activity_locations",
          "label": "Interactive activity locations"
        },
        {
          "description": "Your deterministic social interactions need a small, cohesive set of original illustrated resident characters that support a welcoming, community-focused city atmosphere.",
          "id": "local_residents",
          "label": "Simulated local residents"
        },
        {
          "description": "Your map needs subtle visual feedback for selected destinations, avatar routes or movement, hover, focus, and active location states, using the vivid electric violet/indigo accent accessibly.",
          "id": "map_interaction_feedback",
          "label": "Map interaction feedback"
        },
        {
          "description": "Your responsive English interface needs polished location cards, activity controls, top status indicators, and clear loading, empty, and error states using the starter’s bundled display and body typefaces.",
          "id": "location_card_ui",
          "label": "Location cards and status interface"
        }
      ]
    },
