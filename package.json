{
  "name": "allconnect",
  "version": "1.0.0",
  "description": "AllConnect platform (Lagos life-sim) with GameHub as an app. Node.js, Express, MongoDB, Socket.io, Passport.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test",
    "check": "node --check server.js && find games routes config models sockets -name \"*.js\" -print0 | xargs -0 -n1 node --check",
    "build:dictionary": "node scripts/build-dictionary.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-mongo": "^5.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "mongoose": "^8.5.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0",
    "socket.io": "^4.7.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "word-list": "^4.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "optionalDependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "redis": "^4.6.14"
  }
}
