# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=3000
SESSION_SECRET=change_this_to_a_long_random_string
CLIENT_URL=http://localhost:3000

# MongoDB
# Local:  mongodb://127.0.0.1:27017/gamehub
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gamehub
MONGODB_URI=mongodb://127.0.0.1:27017/gamehub

# Google OAuth 2.0
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be: <CLIENT_URL>/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
