PORT=3000
SESSION_SECRET=replace-with-a-long-random-string
CLIENT_URL=http://localhost:3000
# Set this to the real public HTTPS origin in production for canonical tags and /sitemap.xml.
PUBLIC_SITE_URL=
MONGODB_URI=mongodb://localhost:27017/allconnect
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Songify: official YouTube search + embedded playback (optional). Keep the API key server-side. ----
# Enable YouTube Data API v3 in Google Cloud; restrict this key to that API and your server where possible.
YOUTUBE_API_KEY=

# ---- Pet Answer mode: built-in rules always work; Gemini is the preferred optional provider. ----
PET_AI_PROVIDER=gemini
OPENAI_API_KEY=
PET_AI_API_KEY=
PET_AI_BASE_URL=https://api.openai.com/v1
PET_AI_MODEL=gpt-6-luna
PET_AI_STT_MODEL=gpt-transcribe
PET_AI_DAILY=60
# Gemini is optional; typed answers fall back to the built-in Pet Brain if it fails.
# Accepted server-side key names: GEMINI_API_KEY, GOOGLE_API_KEY, GEMINI_KEY, or GOOGLE_GENAI_API_KEY.
GEMINI_API_KEY=
GEMINI_MODEL=
# GEMINI_MODEL is tried first, followed by gemini-3.5-flash-lite and gemini-3.8-flash.

# ---- P-Gist reels / video (Mux). Server-side only; never expose the token secret to the browser. ----
# Required to turn video uploads on. Mux dashboard > Settings > API Access Tokens (permission: Mux Video, read + write).
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Optional: only needed to keep playing Mux assets that were already created with signed playback.
# New P-Gist Reels use public playback for compatibility with the earlier working version.
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=

# Optional: Mux tells the server the moment a video is ready. Mux dashboard > Settings > Webhooks:
#   URL = https://YOUR-SITE/api/ac/gist/mux-webhook   then copy the signing secret here.
MUX_WEBHOOK_SECRET=

# Optional: Mux Data playback quality (buffering / failures). Mux dashboard > Data > Environments > Environment Key (public).
MUX_DATA_ENV_KEY=

# Optional: auto-generated English captions (Mux bills per minute of video). Set to true to enable.
MUX_CAPTIONS=false
