; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

boot_splash/show_image=false
boot_splash/fullsize=true
boot_splash/use_filter=true
boot_splash/bg_color=Color(0.07843, 0.10196, 0.11765, 1)




config/name="All Connect"
config/description="A social life simulation set in an original connected city."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/share/favicon.png"

[autoload]

TuningBridge="*res://scripts/manus/preview/tuning_adapter.gd"

ManusFontTheme="*res://autoload/manus_font_theme.gd"

SaveStore="*res://autoload/save_store.gd"
I18n="*res://autoload/i18n.gd"
TuningStore="*res://autoload/tuning_store.gd"
AudioDirector="*res://autoload/audio_director.gd"

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

